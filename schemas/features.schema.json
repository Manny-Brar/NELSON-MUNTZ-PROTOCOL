{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nelson-muntz.claude.dev/schemas/features.schema.json",
  "title": "Nelson Muntz v5.0 Features Schema",
  "description": "Schema for structured feature tracking in Nelson Muntz v5.0 loops. JSON format chosen because models are less likely to corrupt JSON compared to Markdown. Backwards-compatible with v3.0.0 — all v5 fields are optional with defaults.",
  "type": "object",
  "required": ["version", "features", "summary"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["3.0.0", "5.0.0"],
      "description": "Schema version for compatibility checking. v5.0.0 adds compound learning, drift scoring, and red-team fields."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the feature list was created"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification timestamp"
    },
    "original_prompt": {
      "type": "string",
      "description": "The original task prompt for reference"
    },
    "features": {
      "type": "array",
      "description": "List of features to implement",
      "items": {
        "type": "object",
        "required": ["id", "description", "passes", "attempts", "max_attempts", "priority"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]+$",
            "description": "Feature ID (e.g., F1, F2, F3)"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "Clear description of what this feature does"
          },
          "steps": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Ordered steps to implement this feature"
          },
          "verification": {
            "type": "string",
            "description": "Command to verify feature works (e.g., 'npm run test:auth')"
          },
          "passes": {
            "type": "boolean",
            "default": false,
            "description": "Whether feature has passed both spec and quality validation"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "blocked"],
            "default": "pending",
            "description": "Current status of the feature"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "description": "Priority order (1 = highest priority, implement first)"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Number of iterations that have attempted this feature"
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "default": 3,
            "description": "Maximum attempts before marking as blocked (3-fix rule)"
          },
          "blocked_by": {
            "type": "array",
            "items": {"type": "string"},
            "description": "IDs of features that must complete first (e.g., ['F1', 'F2'])"
          },
          "blocked_reason": {
            "type": "string",
            "description": "Explanation of why feature is blocked (if status is 'blocked')"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "description": "When work on this feature began"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "description": "When feature was completed or blocked"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes about implementation"
          },
          "compound_value": {
            "type": "string",
            "default": "",
            "description": "v5.0: What reusable pattern or institutional knowledge this feature creates. Guides compound learning extraction."
          },
          "skills_required": {
            "type": "array",
            "items": {"type": "string"},
            "default": [],
            "description": "v5.0: Skill files that executor should read before implementing (e.g., 'nelson-wall-breaker.md')"
          },
          "red_team_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "attack_vector": {
                  "type": "string",
                  "description": "What was tested (e.g., 'SQL injection on search input')"
                },
                "result": {
                  "type": "string",
                  "enum": ["safe", "vulnerable", "mitigated", "accepted_risk"],
                  "description": "Outcome of the red-team test"
                },
                "notes": {
                  "type": "string",
                  "description": "Details about the finding"
                }
              }
            },
            "default": [],
            "description": "v5.0: Adversarial red-team review findings from Stage 3 validation"
          },
          "drift_score_at_completion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "v5.0: Drift score (0-10) when this feature was completed. Useful for trend analysis."
          },
          "pattern_extracted": {
            "type": "string",
            "default": "",
            "description": "v5.0: Name of success pattern extracted after completing this feature"
          },
          "anti_pattern_found": {
            "type": "string",
            "default": "",
            "description": "v5.0: Name of anti-pattern discovered during implementation"
          },
          "asi_notes": {
            "type": "string",
            "default": "",
            "description": "v5.0: Actionable Side Information — diagnostic insight explaining WHY success/failure occurred (GEPA-inspired)"
          },
          "iteration_completed": {
            "type": "integer",
            "minimum": 1,
            "description": "v5.0: Which iteration number completed this feature"
          },
          "validation_stages": {
            "type": "object",
            "description": "v5.0: Three-stage validation results",
            "properties": {
              "spec_compliance": {
                "type": "boolean",
                "default": false,
                "description": "Stage 1: All requirements implemented?"
              },
              "quality_assurance": {
                "type": "boolean",
                "default": false,
                "description": "Stage 2: Tests, lint, build, types pass?"
              },
              "red_team_review": {
                "type": "boolean",
                "default": false,
                "description": "Stage 3: Adversarial review completed?"
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "completed", "blocked", "in_progress", "pending"],
      "description": "Summary counts for quick status check",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of features"
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "description": "Features with passes: true"
        },
        "blocked": {
          "type": "integer",
          "minimum": 0,
          "description": "Features marked as blocked"
        },
        "in_progress": {
          "type": "integer",
          "minimum": 0,
          "description": "Features currently being worked on"
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "description": "Features not yet started"
        },
        "patterns_extracted": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "v5.0: Total success patterns extracted across all features"
        },
        "anti_patterns_found": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "v5.0: Total anti-patterns discovered across all features"
        },
        "avg_drift_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "v5.0: Average drift score across completed features"
        },
        "compound_learning_rate": {
          "type": "string",
          "enum": ["accelerating", "stable", "decelerating", "unknown"],
          "default": "unknown",
          "description": "v5.0: Whether iterations are getting easier (accelerating) or harder (decelerating)"
        }
      }
    },
    "v5_metrics": {
      "type": "object",
      "description": "v5.0: Aggregate metrics for self-evolving evaluation. Optional — only present in v5.0.0 schemas.",
      "properties": {
        "total_iterations": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Total iterations executed"
        },
        "total_research_queries": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Total web searches conducted across all iterations"
        },
        "walls_encountered": {
          "type": "object",
          "description": "Count of each wall type hit across all iterations",
          "properties": {
            "error": {"type": "integer", "default": 0},
            "knowledge": {"type": "integer", "default": 0},
            "design": {"type": "integer", "default": 0},
            "dependency": {"type": "integer", "default": 0},
            "complexity": {"type": "integer", "default": 0}
          }
        },
        "circuit_breakers_triggered": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Number of times drift circuit breaker fired"
        },
        "skills_refined": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skill_name": {"type": "string"},
              "revision": {"type": "string"},
              "iteration": {"type": "integer"}
            }
          },
          "default": [],
          "description": "GEPA-inspired skill refinements applied during this loop"
        }
      }
    },
    "completion_criteria": {
      "type": "object",
      "description": "Conditions for loop completion",
      "properties": {
        "all_features_pass": {
          "type": "boolean",
          "description": "True when all non-blocked features pass"
        },
        "completion_promise": {
          "type": "string",
          "description": "The promise phrase that signals completion"
        },
        "minimum_features": {
          "type": "integer",
          "description": "Minimum features that must pass for completion"
        }
      }
    }
  },
  "examples": [
    {
      "version": "5.0.0",
      "created_at": "2026-03-19T00:00:00Z",
      "last_updated": "2026-03-19T00:00:00Z",
      "original_prompt": "Build a REST API with authentication",
      "features": [
        {
          "id": "F1",
          "description": "Create user registration endpoint with validation",
          "steps": [
            "Create POST /api/users endpoint",
            "Add input validation",
            "Hash password before storage",
            "Return JWT token on success"
          ],
          "verification": "npm run test:auth",
          "passes": true,
          "status": "completed",
          "priority": 1,
          "attempts": 1,
          "max_attempts": 3,
          "blocked_by": [],
          "compound_value": "Establishes auth pattern reusable by F2-F4",
          "skills_required": ["database-supabase.md"],
          "red_team_findings": [
            {
              "attack_vector": "SQL injection on email field",
              "result": "safe",
              "notes": "Parameterized queries via ORM"
            },
            {
              "attack_vector": "Password brute force",
              "result": "mitigated",
              "notes": "Rate limiting added"
            }
          ],
          "drift_score_at_completion": 1,
          "pattern_extracted": "auth-endpoint-pattern",
          "anti_pattern_found": "",
          "asi_notes": "Success enabled by reading database-supabase skill first — RLS setup was correct on first attempt",
          "iteration_completed": 2,
          "validation_stages": {
            "spec_compliance": true,
            "quality_assurance": true,
            "red_team_review": true
          }
        },
        {
          "id": "F2",
          "description": "Create login endpoint with JWT generation",
          "steps": [
            "Create POST /api/login endpoint",
            "Verify credentials",
            "Generate JWT token",
            "Return token and user info"
          ],
          "verification": "npm run test:login",
          "passes": false,
          "status": "pending",
          "priority": 2,
          "attempts": 0,
          "max_attempts": 3,
          "blocked_by": ["F1"],
          "compound_value": "Reuses auth-endpoint-pattern from F1",
          "skills_required": []
        }
      ],
      "summary": {
        "total": 2,
        "completed": 1,
        "blocked": 0,
        "in_progress": 0,
        "pending": 1,
        "patterns_extracted": 1,
        "anti_patterns_found": 0,
        "avg_drift_score": 1.0,
        "compound_learning_rate": "accelerating"
      },
      "v5_metrics": {
        "total_iterations": 2,
        "total_research_queries": 6,
        "walls_encountered": {
          "error": 0,
          "knowledge": 1,
          "design": 0,
          "dependency": 0,
          "complexity": 0
        },
        "circuit_breakers_triggered": 0,
        "skills_refined": []
      },
      "completion_criteria": {
        "all_features_pass": false,
        "completion_promise": "ALL FEATURES COMPLETE",
        "minimum_features": 2
      }
    }
  ]
}
